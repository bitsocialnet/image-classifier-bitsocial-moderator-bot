{
    "name": "image-classifier-bitsocial-moderator-bot",
    "version": "0.1.0",
    "private": true,
    "description": "Moderator bot that approves or rejects posts in a PKC community's mod queue by classifying their linked image with a self-hosted CLIP/SigLIP model",
    "keywords": [
        "bitsocial",
        "pkc",
        "moderation",
        "moderator-bot",
        "image-classification",
        "clip",
        "siglip",
        "zero-shot",
        "immich",
        "self-hosted",
        "p2p"
    ],
    "homepage": "https://github.com/bitsocialnet/image-classifier-bitsocial-moderator-bot#readme",
    "bugs": {
        "url": "https://github.com/bitsocialnet/image-classifier-bitsocial-moderator-bot/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bitsocialnet/image-classifier-bitsocial-moderator-bot.git"
    },
    "license": "GPL-3.0-or-later",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "tsx src/index.ts",
        "create-signer": "tsx scripts/create-signer.ts",
        "evaluate": "node scripts/evaluate.js",
        "test": "vitest run",
        "type-check": "tsc -p tsconfig.json --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@pkcprotocol/pkc-js": "0.0.120",
        "tsx": "4.23.15",
        "undici": "8.12.3",
        "zod": "4.3.5"
    },
    "devDependencies": {
        "@types/node": "22.20.5",
        "prettier": "3.8.1",
        "typescript": "7.0.2",
        "vitest": "4.1.10"
    }
}
